meta {
  name: Create Task
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/api/v1/tasks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Idempotency-Key: report-RPT-8891
}

body:json {
  {
    "taskType": "REPORT_GENERATION",
    "payload": "{\"reportId\":\"RPT-8891\"}",
    "priority": "HIGH",
    "maxAttempts": 5,
    "timeoutSeconds": 120
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
