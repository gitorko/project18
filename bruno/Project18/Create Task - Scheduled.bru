meta {
  name: Create Task - Scheduled
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/tasks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "taskType": "REPORT_GENERATION",
    "payload": "{\"reportId\":\"RPT-8891\"}",
    "priority": 10,
    "maxAttempts": 5,
    "timeoutSeconds": 120,
    "scheduledAt": "2026-01-27T10:30:00Z"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
