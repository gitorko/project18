meta {
  name: Update Poller Config
  type: http
  seq: 10
}

put {
  url: http://localhost:8080/api/v1/poller/config
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "poolSize": 20,
    "batchSize": 50,
    "pollIntervalMs": 500,
    "enabled": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
