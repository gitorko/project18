meta {
  name: Create Task - Timeout Demo
  type: http
  seq: 18
}

post {
  url: http://localhost:8080/api/v1/tasks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "taskType": "sample",
    "payload": "{\"processingTimeMs\": 30000}",
    "priority": 0,
    "timeoutSeconds": 5
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
