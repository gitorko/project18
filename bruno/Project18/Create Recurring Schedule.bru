meta {
  name: Create Recurring Schedule
  type: http
  seq: 22
}

post {
  url: http://localhost:8080/api/v1/schedules
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "taskType": "CACHE_REFRESH",
    "payload": "{}",
    "priority": "MEDIUM",
    "scheduledAt": "2026-11-25T09:00:00Z",
    "intervalSeconds": 3600,
    "maxAttempts": 3
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
