meta {
  name: Create Task
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/api/v1/tasks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "taskType": "REPORT_GENERATION",
    "payload": "{\"reportId\":\"RPT-8891\"}",
    "priority": 10,
    "maxAttempts": 5
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
